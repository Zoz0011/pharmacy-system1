{
  "name": "pharmacore-backend",
  "version": "1.0.0",
  "description": "PharmaCore Pharmacy Management System Backend v1",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "prisma": "prisma",
    "setup": "node ../scripts/ensure-env.js && prisma generate && prisma db push --skip-generate && node prisma/seed.js",
    "migrate": "prisma migrate dev",
    "seed": "node prisma/seed.js"
  },
  "keywords": [
    "pharmacy",
    "express",
    "prisma",
    "sqlite",
    "jwt"
  ],
  "author": "Ziad Reda",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^9.0.5"
  },
  "devDependencies": {
    "nodemon": "^3.1.14",
    "prisma": "^6.19.0"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "prisma@6.19.3": true
  }
}
