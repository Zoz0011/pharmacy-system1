{
  "name": "pharmacore-backend",
  "version": "1.0.0",
  "description": "PharmaCore Pharmacy Management System Backend v1",
  "main": "index.js",
  "type": "commonjs",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "prisma": "prisma",
    "setup": "node ../scripts/ensure-env.js && prisma generate && prisma db push --skip-generate && node prisma/seed.js",
    "migrate": "prisma migrate dev",
    "seed": "node prisma/seed.js",
    "snapshot:turso": "node scripts/prepare-turso-import.js",
    "migrate:turso": "node scripts/migrate-sqlite-to-turso.js",
    "migrate:firestore": "node scripts/migrate-sqlite-to-firestore.js",
    "test": "node test/architecture.test.js"
  },
  "keywords": [
    "pharmacy",
    "express",
    "prisma",
    "sqlite",
    "jwt"
  ],
  "author": "Ziad Reda",
  "license": "ISC",
  "dependencies": {
    "@libsql/client": "^0.8.1",
    "@prisma/adapter-libsql": "^6.19.3",
    "@prisma/client": "^6.19.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "firebase-admin": "^14.3.0",
    "firebase-functions": "^7.3.2",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^9.0.5",
    "serverless-http": "^3.2.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.14",
    "prisma": "^6.19.0"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "prisma@6.19.3": true
  },
  "engines": {
    "node": "20"
  }
}
