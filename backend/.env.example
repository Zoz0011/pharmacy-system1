DATABASE_URL="file:./dev.db"
# On Render, Prisma CLI still needs a local SQLite URL at build time. The app
# itself uses the persistent Turso database when both values below are set.
TURSO_DATABASE_URL=""
TURSO_AUTH_TOKEN=""
REQUIRE_REMOTE_DATABASE=false
JWT_SECRET="pharmacore_super_secret_key_change_later"
PORT=5000
NODE_ENV=development
# In production, list the exact frontend origins separated by commas.
CORS_ORIGINS="https://your-project.web.app,https://your-project.firebaseapp.com"

# Firebase Functions automatically use Firestore. Set this only when using the
# Firestore emulator or Firebase credentials during local development.
USE_FIRESTORE=false

# Password recovery email (example: Gmail SMTP with an App Password)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="your-account@gmail.com"
SMTP_PASS="your-app-password"
SMTP_FROM="Pharmacy <your-account@gmail.com>"
